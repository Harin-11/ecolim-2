<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/input_surface" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="@color/input_stroke" />
            <padding
                android:left="16dp"
                android:right="48dp"
                android:top="12dp"
                android:bottom="12dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_arrow_drop_down_24"
        android:end="14dp"
        android:gravity="end|center_vertical" />
</layer-list>
